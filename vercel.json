{
  "version": 2,
  "builds": [
    {
      "src": "/backend/src/app.js", 
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/src/App.jsx" 
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}